@echo off
rem Copy this file to .env.local.bat and replace the placeholder values.
rem .env.local.bat is ignored by Git and must not contain quoted extra spaces.

set "INSECT_API_USERNAME=your-insect-account"
set "INSECT_API_PASSWORD=your-insect-password"
set "YS7_APP_KEY=your-ys7-app-key"
set "YS7_APP_SECRET=your-ys7-app-secret"
set "DASHSCOPE_API_KEY=your-dashscope-api-key"

rem Optional overrides for an offline/local development setup.
rem set "INSECT_API_BASE_URL=http://app.wlwapp.cn"
rem set "DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com"
rem set "JAVA_OPTS=-Ddevice.mqtt.enabled=false"
rem set "SPRING_DATASOURCE_PASSWORD=your-mysql-password"
