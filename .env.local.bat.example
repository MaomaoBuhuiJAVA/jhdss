@echo off
rem Copy this file to .env.local.bat and replace the placeholder values.
rem .env.local.bat is ignored by Git and must not contain quoted extra spaces.

set "INSECT_API_USERNAME=your-insect-account"
set "INSECT_API_PASSWORD=your-insect-password"
set "YS7_APP_KEY=your-ys7-app-key"
set "YS7_APP_SECRET=your-ys7-app-secret"
rem Required when video encryption is enabled. Find it on the device label or in the EZVIZ app.
set "YS7_VERIFY_CODE=your-device-verification-code"
rem Camera serial is printed on the device label. The default is BG9980884.
rem set "YS7_DEVICE_SERIAL=BG9980884"
rem set "YS7_CHANNEL_NO=1"
rem 2=sub-stream for lower latency; use 1 for higher quality
set "YS7_STREAM_TYPE=2"
set "YS7_FORCE_H264=true"
set "YS7_LIVE_PROTOCOL=4"

rem Enable LAN RTSP when this computer shares Wi-Fi with the camera; FFmpeg required
set "CAMERA_LOCAL_ENABLED=false"
set "CAMERA_LOCAL_HOST=192.168.1.100"
set "CAMERA_LOCAL_PORT=554"
set "CAMERA_LOCAL_USERNAME=admin"
set "CAMERA_LOCAL_PASSWORD=your-camera-verification-code"
set "CAMERA_LOCAL_PATH=/ch1/main"
set "CAMERA_LOCAL_FALLBACK_PATH=/ch1/sub"
set "CAMERA_LOCAL_PREFER_FALLBACK=true"
set "CAMERA_LOCAL_TRANSPORT=tcp"
set "CAMERA_LOCAL_FFMPEG_PATH=ffmpeg"
rem Low-latency output; use a smaller width/bitrate on slower computers
set "CAMERA_LOCAL_WIDTH=720"
set "CAMERA_LOCAL_VIDEO_BITRATE=2400k"
set "CAMERA_LOCAL_VIDEO_BUFFER_SIZE=3600k"
set "CAMERA_LOCAL_CONNECT_TIMEOUT_MS=8000"
set "CAMERA_LOCAL_STARTUP_TIMEOUT_MS=30000"
set "CAMERA_LOCAL_STALE_TIMEOUT_MS=30000"
set "CAMERA_LOCAL_RESTART_COOLDOWN_MS=10000"
rem Bluetooth PAN irrigation controller web console; adjust if its link-local IP changes
set "CONTROL_PANEL_BASE_URL=http://169.254.240.33"
rem Automatic patrol calibration and 4K photo output
set "PATROL_AUTO_OUTPUT_PATH=E:\LabelImg资料图片\摄像头实际拍摄照片"
set "PATROL_HORIZONTAL_TRAVEL_MS=18422"
set "PATROL_VERTICAL_TRAVEL_MS=11587"
rem Keep below 0.97 so timed movement does not strike the hard limit
set "PATROL_COVERAGE_RATIO=0.92"
set "DASHSCOPE_API_KEY=your-dashscope-api-key"
set "SPRING_DATASOURCE_USERNAME=root"
set "SPRING_DATASOURCE_PASSWORD=your-mysql-password"

rem USR DTU MQTT transparent mode
set "MQTT_BROKER_URL=tcp://11046xnld7705.vicp.fun:1883"
rem This is the web backend client id; keep it different from the DTU id jhdskouhong.
set "MQTT_CLIENT_ID=jhdss-web-control"
rem Append a unique instance id so multiple computers can stay connected
set "MQTT_APPEND_INSTANCE_ID=true"
set "MQTT_USERNAME=mqttuser"
set "MQTT_PASSWORD=replace-with-your-mqtt-password"
set "MQTT_CLEAN_SESSION=false"
set "MQTT_RECONNECT_INTERVAL_MS=10000"
set "MQTT_RECONNECT_INITIAL_DELAY_MS=10000"
set "MQTT_TRANSPARENT_MODE=true"
set "MQTT_IGNORE_ECHO=true"
rem These values must be the actual serial frames from the motor/relay manual.
rem Example format: 01 05 00 00 FF 00 8C 3A
set "MOTOR_DIRECTION_OPEN_HEX="
set "MOTOR_DIRECTION_CLOSE_HEX="
set "MOTOR_STATE_OPEN_HEX="
set "MOTOR_STATE_CLOSE_HEX="

rem Optional overrides for an offline/local development setup.
rem set "INSECT_API_BASE_URL=http://app.wlwapp.cn"
rem set "DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com"
rem set "JAVA_OPTS=-Ddevice.mqtt.enabled=false"
